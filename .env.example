# ---------------------------------------------------------------
# OpenCounsel environment variables.  Copy to .env (never commit it).
# ---------------------------------------------------------------

# Postgres connection string. With Supabase: Project Settings -> Database ->
# Connection string -> "Transaction pooler". Local Postgres also works.
# Required for everything (app, db:push, db:seed, ingest).
DATABASE_URL=

# Supabase Auth (Project Settings -> API). Required for login, saved lists, AI chat, admin.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# The account with this email becomes an admin the first time it logs in.
ADMIN_EMAIL=

# AI counselor. Free Google Gemini key: https://aistudio.google.com/apikey
# Leave AI_API_KEY empty to run the counselor in mock mode (no real AI answers).
AI_API_KEY=
AI_MODEL=gemini-3.6-flash

# Informational label shown on the admin Config page.
APP_MODE=development
