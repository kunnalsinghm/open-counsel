# --- App mode ---
# development => payment bypass, mock AI, demo data allowed
# production  => real auth, real payments, rate limits enforced
APP_MODE=development
PAYMENTS_ENABLED=false

# --- Database ---
# SQLite for local dev (zero setup):
DATABASE_URL="file:./dev.db"
# For production, use Postgres instead, e.g.:
# DATABASE_URL="postgresql://user:password@host:5432/opencounsel"

# --- Auth (fill in if using Supabase Auth or NextAuth) ---
AUTH_PROVIDER_URL=
AUTH_PROVIDER_ANON_KEY=

# --- AI provider ---
# Leave blank to run the AI counselor in deterministic mock mode.
AI_API_KEY=
AI_MODEL=claude-haiku-4-5-20251001

# --- Payments (Razorpay example) ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# --- Email provider ---
EMAIL_PROVIDER_API_KEY=
EMAIL_FROM=support@opencounsel.example

# --- Admin ---
ADMIN_EMAIL=admin@opencounsel.example

# --- URLs ---
APP_URL=http://localhost:3000
API_URL=http://localhost:3000/api

# --- Analytics (optional, privacy-conscious) ---
ANALYTICS_WRITE_KEY=
